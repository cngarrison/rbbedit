# Copyright:  Copyright (c) 2014 Charlie Garrison
#             All Rights Reserved.
# Created on: 2014-09-01
#    Purpose: Script to edit local files on remote workstation using BBEdit
#-----------------------------------------------------------------------
# v0.1 Requires ExpanDrive for remote volume mounting
# v0.2 Parse ARGS using getopts
# v0.3 Multiple copy methods supported, absolute or relative paths, better error handling
# v0.4 Better support for `sh` on different platforms
# v0.5 Command option to send or get SSH keys to/from BBEdit workstation
# v0.6 Installer script and command option to self-update script
# v0.7 Add 'ftp' as a copy method
# v0.8 Command option to set path to `bbedit`; default changed to /usr/local/bin/bbedit
# v1.0 Command option to request Automation permission from `sshd-keygen-wrapper` to BBEdit
#      Command option to create a `bbedit-restricted` file for use in `authorized_keys`
# v1.1 Command option to set SSH identity file for connections to BBEdit workstation (-I / bbedit_ssh_identity)
#      Fix -U/-H options, rsync SSH port, and key-copy messages
# v1.2 Pre/post edit hooks (pre_edit_hook / post_edit_hook, -e / -E)
#      Non-existent files are created on open, and removed again if nothing was saved
#      Installer and self-update download the latest GitHub release instead of the development branch
#      -V / --version prints the version
#-----------------------------------------------------------------------

host_sftp_user=""
host_sftp_host=""
bbedit_ssh_user=""
bbedit_ssh_host=""
bbedit_ssh_port=""
# Identity file for ssh/scp/rsync connections from this host to the BBEdit workstation.
# When set, adds `-i <file> -o IdentitiesOnly=yes` so only this key is offered; avoids
# "Too many authentication failures" when ssh-agent holds many keys. Leading ~/ is expanded.
bbedit_ssh_identity=""
# host_sftp_identity -- NOT YET SUPPORTED (reserved name)
# Intended: identity file BBEdit should use for the workstation -> server-host SFTP connection
# (sftp/ftp copy methods). The `bbedit` CLI currently has no way to pass an identity with an
# sftp:// URL, so this cannot be applied. Workaround: on the workstation, add to ~/.ssh/config
# for the $host_sftp_host alias:  IdentityFile <file>  and  IdentitiesOnly yes
# (or set the identity on the server in BBEdit's own settings).
# If `bbedit` gains such an option, add: default var here, `-J` getopts flag, and pass it in
# the sftp method's `$bbedit_command` call below.
#host_sftp_identity=""
local_ssh_copy_id_command="ssh-copy-id"
bbedit_ssh_copy_id_command="/usr/local/bin/ssh-copy-id"
osascript_command="/usr/bin/osascript"
osascript_command_script="tell application \"BBEdit\"
	activate
	display dialog \"Show me the perms!\" buttons \"Granted\" default button \"Granted\" 
end tell"
copy_method="sftp" # scp | expan | rsync | sftp | ftp
ftp_absolute=0
expan_volume=""
bbedit_wait_args=" --wait --resume"
bbedit_wait="$bbedit_wait_args"
bbedit_prog="/usr/local/bin/bbedit"
local_key_identity=""
bbedit_key_identity=""
yes_agree=""
verbose=0
request_perms=0
copy_restricted=0
self_update=0  #don't set this to true in ~/.rbbedit, really, just don't
# Hooks: commands, or shell functions defined in ~/.rbbedit, run for each file with
# its absolute path appended as the last argument. See README "Edit Hooks".
pre_edit_hook=""          # run before the file is opened; non-zero exit skips the file
post_edit_hook=""         # run after the file is closed in BBEdit (wait mode only)
post_edit_hook_always=0   # 1 = run post_edit_hook even when the file is unchanged
hooks_enabled=1           # -e enables, -E disables
create_missing=1          # open non-existent files as new empty files (parent dir must exist)
exit_status=0

# get user defaults, can set user defaults for any of the above settings
if [ -r ~/.rbbedit ] ; then
   . ~/.rbbedit
fi

# Version is the newest entry in the changelog above, so there is only one place to update it
show_version() {
   rbbedit_version=$(sed -n 's/^# \(v[0-9][0-9.]*\) .*/\1/p' "$0" | tail -1)
   echo "rbbedit $rbbedit_version"
   exit 0
}

# getopts has no long options, so look for --version before parsing
for arg in "$@"
do
   case "$arg" in
      --version) show_version;;
      --) break;;
   esac
done

# Check that at least one argument was specified
if [ $# -lt 1 ] ; then
   echo "You must specify at least 1 file name or option."
   exit 1
fi

while getopts U:H:u:h:p:I:m:x:k:i:y:b:wWeEvVPR+? opt
do case "$opt" in
   U) host_sftp_user="$OPTARG";;
   H) host_sftp_host="$OPTARG";;
   u) bbedit_ssh_user="$OPTARG";;
   h) bbedit_ssh_host="$OPTARG";;
   p) bbedit_ssh_port="$OPTARG";;
   I) bbedit_ssh_identity="$OPTARG";;
   m) copy_method="$OPTARG";;
   x) expan_volume="$OPTARG"
      copy_method="expan";;
   k) key_copy="$OPTARG";;
   i) local_key_identity="$OPTARG"
      bbedit_key_identity="$OPTARG";;
   w) bbedit_wait="$bbedit_wait_args";;
   W) bbedit_wait="";;
   e) hooks_enabled=1;;
   E) hooks_enabled=0;;
   b) bbedit_prog="$OPTARG";;
   v) verbose=1;;
   V) show_version;;
   P) request_perms=1;;
   R) copy_restricted=1;;
   y) yes_agree="$OPTARG";;
  \+) self_update=1;;
  \?) echo >&2 "Usage: $0 [-U sftp-user] [-H sftp-host] [-u ssh-user] [-h ssh-host | ssh-user@ssh-host] [-p ssh-port] [-I ssh-identity-file] [-m copy-method (sftp | ftp | expan | scp | rsync)] [-x expan-volume] [-w|W] [-e|E] file ..."
      echo >&2 "       $0 [-u ssh-user] [-h ssh-host | ssh-user@ssh-host] [-p ssh-port] [-I ssh-identity-file] [-k copy-direction (get | send)] [-i identity-file] [-y understood] [-P] [-R] ..."
      echo >&2 "       $0 -V | --version"
      exit 1;;
   esac
done

shift_args=$(( $OPTIND-1 ))
shift $shift_args
edit_files=$@


if [ $self_update -gt 0 ] ; then
   echo "Script will update itself using the installer from the latest release at https://github.com/cngarrison/rbbedit"

   # Write update script
   cat > update.sh << EOF
#!/bin/bash
echo "Performing self-update..."
# Use 'curl' to download installer and pipe to 'sh'
export RBBEDIT_INSTALL_PATH="$0"
EOF
   if [ $verbose -gt 0 ] ; then
      echo "curl -fL -o - https://github.com/cngarrison/rbbedit/releases/latest/download/install.sh | bash" >> update.sh
   else
      echo "curl -fsL -o - https://github.com/cngarrison/rbbedit/releases/latest/download/install.sh | bash" >> update.sh
   fi
   cat >> update.sh << EOF
echo "Done."
rm \$0
EOF

   echo "Inserting update process..."
   exec /bin/bash update.sh

   exit 0;
fi

# Check that we have copy method
if [ -z "$copy_method" ] ; then
   echo "You must specify a copy method."
   exit 1
fi

# Set bbedit_ssh_host from SSH_CLIENT if not set already
if [ -z "$bbedit_ssh_host" ] ; then
   bbedit_ssh_host=`echo $SSH_CLIENT | awk '{ print $1}'`
fi
# Set bbedit_ssh_host from `who` if still not set
if [ -z "$bbedit_ssh_host" ] ; then
   bbedit_ssh_host=`who -m | awk 'NR==1{ print $5}' | sed 's/[()]//g'`
fi

# Check that we have ssh host
if [ -z "$bbedit_ssh_host" ] ; then
   echo "You must specify a hostname."
   exit 1
fi

# Add bbedit_ssh_user (if set) to bbedit_ssh_host 
if [ ! -z "$bbedit_ssh_user" ] ; then
   bbedit_ssh_host="$bbedit_ssh_user@$bbedit_ssh_host"
fi


bbedit_ssh_port_arg=""
# Check whether we have ssh port
if [ ! -z "$bbedit_ssh_port" ] ; then
   bbedit_ssh_port_arg="-p $bbedit_ssh_port"
fi

# Identity file for connections to workstation; IdentitiesOnly stops ssh-agent offering every key
bbedit_ssh_identity_arg=""
bbedit_ssh_copy_id_identity_arg=""
if [ ! -z "$bbedit_ssh_identity" ] ; then
   case "$bbedit_ssh_identity" in
      "~/"*) bbedit_ssh_identity="$HOME/${bbedit_ssh_identity#\~/}";;
   esac
   bbedit_ssh_identity_arg="-i $bbedit_ssh_identity -o IdentitiesOnly=yes"
   # ssh-copy-id uses -i for the key being installed, so pass login identity via -o
   bbedit_ssh_copy_id_identity_arg="-o IdentitiesOnly=yes -o IdentityFile=$bbedit_ssh_identity"
fi

# scp and rsync methods require bbedit_wait
if [ $copy_method = "scp" -o $copy_method = "rsync" ] ; then
   # if bbedit_wait is already set, then keep supplied value
   # otherwise set to default wait args
   if [ -z "$bbedit_wait" ] ; then
      bbedit_wait="$bbedit_wait_args"
   fi
fi

bbedit_command="$bbedit_prog $bbedit_wait"
bbedit_ssh_command="ssh $bbedit_ssh_port_arg $bbedit_ssh_identity_arg $bbedit_ssh_host "

if [ $request_perms -gt 0 ] ; then

   ssh_request_perms_command="$bbedit_ssh_command '$osascript_command -e '\''$osascript_command_script'\'''"

   if [ $verbose -gt 0 ] ; then
      echo "request-perms command: $ssh_request_perms_command"
   fi

   if eval "$ssh_request_perms_command"; then
      echo "Permissions granted on BBEdit workstation."
      exit 0
   else
      echo "Unknown error requesting permissions"
      exit 1
   fi
fi


if [ $copy_restricted -gt 0 ] ; then
   echo "Copying bbedit-restricted script to the workstation..."

   # Write bbedit-restricted script to a temporary file
   cat > "/tmp/bbedit-restricted.sh" << 'EOF'
#!/opt/homebrew/bin/bash

if [[ -n $SSH_ORIGINAL_COMMAND ]]; then # command given, so run it
    if [[ $SSH_ORIGINAL_COMMAND == "/usr/bin/osascript -e 'tell application \"BBEdit\""* ]]; then
        # Allow the specific osascript command with the given arguments
        exec /bin/sh -c "$SSH_ORIGINAL_COMMAND"
    elif [[ $SSH_ORIGINAL_COMMAND == */bbedit* || $SSH_ORIGINAL_COMMAND == */bbresults* ]]; then
        # Allow bbedit and bbresults commands and execute them
        exec /bin/sh -c "$SSH_ORIGINAL_COMMAND"
    else
        # Reject all other commands
        echo "Only the specific osascript command, bbedit, and bbresults commands are supported:
$SSH_ORIGINAL_COMMAND"
    fi
else # no command, so ignore
    echo "Only the specific osascript command, bbedit, and bbresults commands are supported"
fi
EOF

   bbedit_scp_port_arg=""
   if [ ! -z "$bbedit_ssh_port" ] ; then
      bbedit_scp_port_arg="-P $bbedit_ssh_port"
   fi
   bbedit_scp_command="scp $bbedit_scp_port_arg $bbedit_ssh_identity_arg -p -q"

   if [ $verbose -gt 0 ] ; then
      echo "SCP command: $bbedit_scp_command"
      echo "Local file: /tmp/bbedit-restricted.sh"
      echo "Copy to: $bbedit_ssh_host:/usr/local/bin/bbedit-restricted"
   fi

   # Copy bbedit-restricted script to the workstation
   $bbedit_scp_command "/tmp/bbedit-restricted.sh" $bbedit_ssh_host:/usr/local/bin/bbedit-restricted

   # Remove the temporary file
   rm "/tmp/bbedit-restricted.sh"

   echo "bbedit-restricted script copied to the workstation at: /usr/local/bin/bbedit-restricted."
   echo "Please add (or modify) the following line to your ~/.ssh/authorized_keys file on the workstation:"
   echo "command=\"/usr/local/bin/bbedit-restricted\",no-port-forwarding,no-X11-forwarding ssh-rsa AAAAB3NzaC1yc2EAAAADAQC... user@host"
   exit 0
fi


if [ ! -z "$key_copy" ] ; then
   if [ "$yes_agree" != 'understood' ] ; then
         echo "Please be aware of the implications of copying SSH public keys. Read the README at https://github.com/cngarrison/rbbedit"
#          echo "You must give your undestanding of the implications of copying SSH public keys. Read the README at https://github.com/cngarrison/rbbedit"
#          exit 1
   fi

   ssh_copy_id_command=""
   if [ $key_copy = "send" -o $key_copy = "put" ]; then
   
      key_identity_arg=""
      if [ ! -z "$local_key_identity" ] ; then
         key_identity_arg="-i $local_key_identity"
      fi

      if [ ! -z "$bbedit_ssh_port_arg" ] ; then
         ssh_copy_id_command="$local_ssh_copy_id_command $key_identity_arg $bbedit_ssh_copy_id_identity_arg $bbedit_ssh_host $bbedit_ssh_port_arg"
      else
         ssh_copy_id_command="$local_ssh_copy_id_command $key_identity_arg $bbedit_ssh_copy_id_identity_arg $bbedit_ssh_host"
      fi

      if [ $verbose -gt 0 ] ; then
         echo "Key Copy Direction: $key_copy"
         echo "Local Key Identity: $local_key_identity"
         echo "ssh-copy-id command: $ssh_copy_id_command"
      fi

      if ${ssh_copy_id_command}; then
         echo "Key copied. Be sure to check contents of ~/.ssh/authorized_keys on BBEdit workstation."
         echo "You can restrict ssh access to only rbbedit - run 'rbbedit -R' to copy the 'bbedit-restricted' command"
         echo "to the BBEdit workstation, and then modify ~/.ssh/authorized_keys as instructed."
         exit 0
      else
         echo "Unknown error copying key"
         exit 1
      fi


   elif [ $key_copy = "get" ]; then
   
      key_identity_arg=""
      if [ ! -z "$bbedit_key_identity" ] ; then
         key_identity_arg="-i $bbedit_key_identity"
      fi

      if [ -z "$HOSTNAME" ] ; then
         HOSTNAME=`hostname`
      fi

      ssh_copy_id_command="$bbedit_ssh_command $bbedit_ssh_copy_id_command $key_identity_arg $USER@$HOSTNAME"

      if [ $verbose -gt 0 ] ; then
         echo "Key Copy Direction: $key_copy"
         echo "Workstation Key Identity: $bbedit_key_identity"
         echo "ssh-copy-id command: $ssh_copy_id_command"
      fi

      if ${ssh_copy_id_command}; then
         echo "Key copied. Be sure to check contents of local ~/.ssh/authorized_keys on server host."
         exit 0
      else
         echo "Unknown error copying key, trying fallback method"

         if [ -z "$bbedit_key_identity" ] ; then
            bbedit_key_identity="~/.ssh/id_rsa.pub"
         fi
         ssh_copy_id_command="$bbedit_ssh_command cat $bbedit_key_identity"

         if [ $verbose -gt 0 ] ; then
            echo "Workstation Key Identity: $bbedit_key_identity"
            echo "ssh-copy-id command: $ssh_copy_id_command  >> ~/.ssh/authorized_keys"
         fi

         bbedit_ssh_key=`$ssh_copy_id_command`
         echo $bbedit_ssh_key >> ~/.ssh/authorized_keys
         
         if [ ! -z "$bbedit_ssh_key" ]; then
            echo "Key copied. Be sure to check contents of local ~/.ssh/authorized_keys on server host."
            exit 0
         else
            echo "Unknown error copying key"
            exit 1
         fi
      fi


   else
      echo "Unknown key copy direction: $key_copy - must be either 'send' or 'get'"
      exit 1
   
   fi
fi

if [ $verbose -gt 0 ] ; then
   echo "Method: $copy_method"
   echo "SSH Command: $bbedit_ssh_command"
   echo "BBEdit Command: $bbedit_command"
   echo "Files: $edit_files"
   echo "Hooks: pre_edit_hook=\"$pre_edit_hook\" post_edit_hook=\"$post_edit_hook\" (enabled=$hooks_enabled)"
fi


# Absolute path for a file argument; for a non-existent file resolve its directory instead
# (BSD readlink -f prints nothing when the file itself is missing)
abs_edit_path() {
   if [ -e "$1" ] ; then
      readlink -n -f "$1"
   else
      abs_dir=`readlink -n -f "$(dirname "$1")"`
      if [ -n "$abs_dir" -a -d "$abs_dir" ] ; then
         echo "${abs_dir%/}/$(basename "$1")"
      fi
   fi
}

# Run a hook with the file path appended; may be a command or a shell function from ~/.rbbedit
run_hook() {
   hook_name="$1"
   hook_cmd="$2"
   hook_path="$3"

   if [ $verbose -gt 0 ] ; then
      echo "Running $hook_name: $hook_cmd $hook_path"
   fi

   RBBEDIT_FILE="$hook_path"
   RBBEDIT_METHOD="$copy_method"
   RBBEDIT_NEW="$edit_new"
   RBBEDIT_CHANGED="$edit_changed"
   export RBBEDIT_FILE RBBEDIT_METHOD RBBEDIT_NEW RBBEDIT_CHANGED

   $hook_cmd "$hook_path"
}

file_cksum() {
   if [ -f "$1" ] ; then
      cksum < "$1"
   fi
}

# Check the file can be edited, run pre_edit_hook, and create the file if it doesn't exist.
# $1 = absolute path, $2 = path as given, $3 = "file" (regular files only) or "any" (files or dirs)
# Returns non-zero if the file should be skipped.
prepare_edit() {
   edit_path="$1"
   edit_new=0
   edit_changed=""
   edit_cksum_before=""

   if [ -z "$edit_path" ] ; then
      echo "Directory not found: $2"
      return 1
   fi

   if [ ! -e "$edit_path" ] ; then
      if [ $create_missing -eq 0 ] ; then
         echo "File not found: $edit_path"
         return 1
      fi
      edit_dir=`dirname "$edit_path"`
      if [ ! -d "$edit_dir" -o ! -w "$edit_dir" ] ; then
         echo "Cannot create new file, directory not found or not writable: $edit_dir"
         return 1
      fi
      edit_new=1
   elif [ ! -r "$edit_path" ] ; then
      echo "File/dir is not readable: $edit_path"
      return 1
   elif [ "$3" = "file" -a ! -f "$edit_path" ] ; then
      ## it should be fine working with directories, but there is non-trivial risk when copying data back
      ## so let's only support editing of single files with this version
      echo "Not a regular file (directories not supported with $copy_method): $edit_path"
      return 1
   fi

   # pre_edit_hook runs before a new file is created, so it sees the filesystem as it was
   if [ $hooks_enabled -gt 0 -a -n "$pre_edit_hook" ] ; then
      if ! run_hook pre_edit_hook "$pre_edit_hook" "$edit_path" ; then
         echo "pre_edit_hook failed, skipping: $edit_path (use -E to skip hooks)"
         exit_status=1
         return 1
      fi
   fi

   if [ $edit_new -gt 0 ] ; then
      if ! touch "$edit_path" ; then
         echo "Cannot create new file: $edit_path"
         return 1
      fi
      echo "New file: $edit_path"
   fi

   edit_cksum_before=$(file_cksum "$edit_path")
   return 0
}

# After BBEdit has closed the file: remove an unsaved new file, then run post_edit_hook if it changed
finish_edit() {
   edit_path="$1"

   # without --wait, bbedit returns before any editing is done
   if [ -z "$bbedit_wait" ] ; then
      if [ $hooks_enabled -gt 0 -a -n "$post_edit_hook" ] ; then
         echo "Not waiting for BBEdit (-W), post_edit_hook not run: $edit_path"
      fi
      return 0
   fi

   if [ -d "$edit_path" ] ; then
      edit_changed="unknown"
   elif [ "$(file_cksum "$edit_path")" = "$edit_cksum_before" ] ; then
      edit_changed=0
   else
      edit_changed=1
   fi

   if [ $edit_new -gt 0 -a "$edit_changed" = "0" ] ; then
      rm -f "$edit_path"
      echo "Nothing saved, removed new file: $edit_path"
      return 0
   fi

   if [ $hooks_enabled -eq 0 -o -z "$post_edit_hook" ] ; then
      return 0
   fi

   if [ "$edit_changed" = "0" -a $post_edit_hook_always -eq 0 ] ; then
      if [ $verbose -gt 0 ] ; then
         echo "File unchanged, post_edit_hook not run: $edit_path"
      fi
      return 0
   fi

   if ! run_hook post_edit_hook "$post_edit_hook" "$edit_path" ; then
      echo "post_edit_hook failed: $edit_path"
      exit_status=1
   fi
}


if [ $copy_method = "expan" ]; then

   # Check that we have ssh host
   if [ -z "$expan_volume" ] ; then
      echo "You must specify an expandrive volume."
      exit 1
   fi
   if [ $verbose -gt 0 ] ; then
      echo "ExpanDrive Volume: $expan_volume"
   fi

   $bbedit_ssh_command /usr/local/bin/expan connect $expan_volume 2>/dev/null

   ## wait for volume mount to finish (HACK!!)
   sleep 3

   for i in $edit_files
   do
      abs_path=`abs_edit_path $i`

      if prepare_edit "$abs_path" "$i" any ; then
         if [ $verbose -gt 0 ] ; then
            echo "Editing file: $abs_path using /Volumes/$expan_volume/$abs_path"
         fi

         $bbedit_ssh_command $bbedit_command /Volumes/$expan_volume/$abs_path

         finish_edit "$abs_path"
      fi

   done

elif [ $copy_method = "sftp" ]; then

   for i in $edit_files
   do
      abs_path=`abs_edit_path $i`

      if prepare_edit "$abs_path" "$i" any ; then

         if [ -z "$host_sftp_user" ] ; then
            host_sftp_user=$USER
         fi

         if [ -z "$host_sftp_host" ] ; then
            if [ -z "$HOSTNAME" ] ; then
               host_sftp_host=`hostname`
            else
               host_sftp_host=$HOSTNAME
            fi
         fi

         url_path="$abs_path"
         if [ -d "$abs_path" ] ; then
            url_path="$abs_path/"
         fi

         if [ $verbose -gt 0 ] ; then
            echo "Editing file: $abs_path using sftp://$host_sftp_user@$host_sftp_host/$url_path"
         fi

         $bbedit_ssh_command $bbedit_command "sftp://$host_sftp_user@$host_sftp_host/$url_path"

         finish_edit "$abs_path"
      fi

   done

elif [ $copy_method = "ftp" ]; then

   for i in $edit_files
   do
      abs_path=`abs_edit_path $i`

      if prepare_edit "$abs_path" "$i" any ; then
         if [ -z "$HOSTNAME" ] ; then
            HOSTNAME=`hostname`
         fi

         url_path="$abs_path"
         if [ -d "$abs_path" ] ; then
            url_path="$abs_path/"
         fi

         if [ $ftp_absolute -eq 0 ]; then
            ## assume ftp server has chrooted to user's HOME dir
            ## so strip $HOME/ from beginning of path
            rel_path=${url_path#$HOME/}
         else
            rel_path=$url_path
         fi

         if [ $verbose -gt 0 ] ; then
            echo "Editing file: $abs_path using ftp://$USER@$HOSTNAME/$rel_path"
         fi

         $bbedit_ssh_command $bbedit_command "ftp://$USER@$HOSTNAME/$rel_path"

         finish_edit "$abs_path"
      fi

   done

elif [ $copy_method = "scp" ]; then

   bbedit_tmp_dir=`$bbedit_ssh_command echo '$TMPDIR'`
   #bbedit_tmp_dir=`$bbedit_ssh_command /usr/bin/getconf DARWIN_USER_CACHE_DIR`
   if [ $verbose -gt 0 ] ; then
      echo "TMP dir: $bbedit_tmp_dir"
   fi

   bbedit_scp_port_arg=""
   if [ ! -z "$bbedit_ssh_port" ] ; then
      bbedit_scp_port_arg="-P $bbedit_ssh_port"
   fi
   bbedit_scp_command="scp $bbedit_scp_port_arg $bbedit_ssh_identity_arg -p -q"

   for i in $edit_files
   do
      abs_path=`abs_edit_path $i`
      filename=`basename "$abs_path"`

      if prepare_edit "$abs_path" "$i" file ; then
         if [ $verbose -gt 0 ] ; then
            echo "Editing file: $abs_path using $bbedit_tmp_dir/$filename"
         fi

         $bbedit_scp_command $abs_path $bbedit_ssh_host:$bbedit_tmp_dir/$filename

         $bbedit_ssh_command $bbedit_command $bbedit_tmp_dir/$filename

         $bbedit_scp_command $bbedit_ssh_host:$bbedit_tmp_dir/$filename $abs_path

         finish_edit "$abs_path"
      fi

   done

elif [ $copy_method = "rsync" ]; then
   
   bbedit_tmp_dir=`$bbedit_ssh_command echo '$TMPDIR'`
   #bbedit_tmp_dir=`$bbedit_ssh_command /usr/bin/getconf DARWIN_USER_CACHE_DIR`
   if [ $verbose -gt 0 ] ; then
      echo "TMP dir: $bbedit_tmp_dir"
   fi

   # rsync --port is for rsync daemon; SSH port/identity go in the remote shell command
   bbedit_rsync_rsh="ssh $bbedit_ssh_port_arg $bbedit_ssh_identity_arg"
   bbedit_rsync_command="rsync -pt -q"

   for i in $edit_files
   do
      abs_path=`abs_edit_path $i`
      filename=`basename "$abs_path"`

      if prepare_edit "$abs_path" "$i" file ; then
         if [ $verbose -gt 0 ] ; then
            echo "Editing file: $abs_path using $bbedit_tmp_dir/$filename"
         fi

         $bbedit_rsync_command -e "$bbedit_rsync_rsh" $abs_path $bbedit_ssh_host:$bbedit_tmp_dir/$filename

         $bbedit_ssh_command $bbedit_command $bbedit_tmp_dir/$filename

         $bbedit_rsync_command -e "$bbedit_rsync_rsh" $bbedit_ssh_host:$bbedit_tmp_dir/$filename $abs_path

         finish_edit "$abs_path"
      fi

   done

else
   echo "Unknown copy method: $copy_method"
   exit 1
   
fi

exit $exit_status


